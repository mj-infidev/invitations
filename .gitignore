# One .gitignore for the whole repo (client/, admin/, api/, shared/).

# ── OS & Editor ──────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# VS Code (keep extensions recommendation, ignore workspace settings)
.vscode/*
!.vscode/extensions.json

# JetBrains IDEs and other editors
.idea/
*.iml
.fleet/
.nova/
.zed/
.phpactor.json

# ── Node (client / admin / api's Vite) ───────────────────────
node_modules/
dist/
dist-ssr/
*.local

# Logs
/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Laravel (api) ─────────────────────────────────────────────
api/vendor/
api/public/build/
api/public/hot
api/public/storage
api/storage/*.key
api/storage/pail/
api/.phpunit.result.cache
api/.phpunit.cache/
api/auth.json
api/database/*.sqlite

# ── Environment files (NEVER commit secrets) ──────────────────
.env
.env.*
!.env.example

# ── Misc ──────────────────────────────────────────────────────
*.zip
*.tar.gz
Homestead.json
Homestead.yaml
