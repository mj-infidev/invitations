APP_NAME=Invitations
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Vue apps allowed by CORS (config/cors.php). Always open the apps on `localhost`,
# never 127.0.0.1 — they're different hosts for cookies.
FRONTEND_CLIENT_URL=http://localhost:5173
FRONTEND_ADMIN_URL=http://localhost:5174

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=invitations
DB_USERNAME=maha
DB_PASSWORD=
# Tamil text needs utf8mb4. These match the defaults in config/database.php.
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Tamil on invitations and in the builder. Off = English only (the Tamil is kept, just hidden).
TAMIL_ENABLED=false

# Name in the "made with" line at the end of every invitation (an open decision in PLAN.md).
BRAND_NAME=Invitations

# Customer sign-in with Google (Google Cloud Console > Google Auth Platform > Clients,
# a Web application client). The redirect URI must be listed there exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Razorpay (dashboard > Account & Settings > API Keys; rzp_test_ keys for test mode).
# The webhook secret is a string you choose; put the same one on the webhook in the
# dashboard, or use it with `php artisan payments:replay-webhook` locally.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# First admin, created by AdminSeeder. Both empty = no admin is seeded.
# Never put a real password in this file.
ADMIN_EMAIL=
ADMIN_PASSWORD=
